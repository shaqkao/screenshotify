{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screenshotify",
  "version": "../package.json",
  "identifier": "app.screenshotify.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Screenshotify",
        "width": 1360,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Screenshotify contributors",
    "copyright": "MIT licensed",
    "category": "Utility",
    "shortDescription": "AI screenshot renamer",
    "longDescription": "Screenshotify watches your screenshot folders, asks an AI model you choose for a meaningful filename, and renames the file once you approve the suggestion.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/shaqkao/screenshotify/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4MURDQjVGRjc4QkY2RDYKUldUVzlvdjNYOHNkT0lqKzlub3hES0hwdldOUEpqcDJRVDA4TEtPTkRaSEpoVDZEMUc1a0hHdmkK"
    }
  }
}
